# Copy this file to .env for local development:  cp .env.example .env
# .env is git-ignored. Never put real secrets in this example file.

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_USER=dtp
POSTGRES_PASSWORD=dtp_local_dev_only
POSTGRES_DB=dhaka_tesla_pool
# Port on YOUR machine. 5433 avoids clashing with a Postgres you may already run on 5432.
POSTGRES_PORT=5433

# --- Backend (Express API) ---
# The backend reads this same root .env in development (npm run dev uses Node's --env-file-if-exists).
PORT=4000
LOG_LEVEL=info

# Database (used by the backend and by Prisma)
DATABASE_URL=postgresql://dtp:dtp_local_dev_only@localhost:5433/dhaka_tesla_pool
# Separate database for automated tests (created automatically, wiped between tests)
TEST_DATABASE_URL=postgresql://dtp:dtp_local_dev_only@localhost:5433/dhaka_tesla_pool_test

# --- Authentication ---
# Signs session tokens. At least 32 characters. This value is for local development ONLY:
# production uses its own long random secret (e.g. from: openssl rand -base64 48).
JWT_SECRET=local-dev-only-change-me-0123456789abcdef
# The web app's address: the only origin allowed to send POST requests to the API.
FRONTEND_ORIGIN=http://localhost:3000
# bcrypt cost for new password hashes (12 recommended; tests use 4 to stay fast).
BCRYPT_COST=12
# Login/register attempts allowed per IP address per 15 minutes.
AUTH_RATE_LIMIT_MAX=10
