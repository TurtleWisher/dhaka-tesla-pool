# Copy this file to .env for local development:  cp .env.example .env
# .env is git-ignored. Never put real secrets in this example file.

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_USER=dtp
POSTGRES_PASSWORD=dtp_local_dev_only
POSTGRES_DB=dhaka_tesla_pool
# Port on YOUR machine. 5433 avoids clashing with a Postgres you may already run on 5432.
POSTGRES_PORT=5433

# --- Backend (Express API) ---
# The backend reads this same root .env in development (npm run dev uses Node's --env-file-if-exists).
PORT=4000
LOG_LEVEL=info

# Database (used by the backend and by Prisma)
DATABASE_URL=postgresql://dtp:dtp_local_dev_only@localhost:5433/dhaka_tesla_pool
# Separate database for automated tests (created automatically, wiped between tests)
TEST_DATABASE_URL=postgresql://dtp:dtp_local_dev_only@localhost:5433/dhaka_tesla_pool_test
